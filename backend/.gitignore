cat > .gitignore << 'EOF'
# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables / secrets
.env
.env.local

# Databases
*.db
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Distribution
build/
dist/
*.egg-info/
EOF